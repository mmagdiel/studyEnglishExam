---
import BaseLayout from "../layouts/BaseLayout.astro";
import AppHeader from "../components/AppHeader.astro";
import { topics } from "../data/topics";
import { BookCheck, Download, Share } from "lucide-react";


const exerciseCount = (t: (typeof topics)[number]) =>
	t.reading.length + t.structures.length + t.speaking.length + t.writing.length;
---

<BaseLayout title="Grammar Master">
	<AppHeader subtitle="Choose a grammar topic to practice" />

	<!-- Extra bottom padding so the floating Test button never covers the last card. -->
	<main class="mx-auto max-w-md px-4 pb-32 sm:max-w-2xl md:max-w-4xl lg:max-w-5xl">
		<!-- Shown only when this browser can install the app and it isn't installed yet. -->
		<section
			id="install-card"
			hidden
			class="mb-6 rounded-3xl border border-indigo-200 bg-indigo-50 p-5"
		>
			<div class="flex items-center gap-4">
				<img src="/icons/icon-192.png" alt="" width="48" height="48" class="rounded-xl" />
				<div class="min-w-0 flex-1">
					<h2 class="font-bold text-slate-800">Install Grammar Master</h2>
					<p class="text-sm text-slate-600">Open it from your home screen like an app, even offline.</p>
				</div>
				<button
					id="install-button"
					type="button"
					class="flex shrink-0 items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 font-bold text-white shadow-md transition hover:bg-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-300"
				>
					<Download className="size-5" />
					Install
				</button>
			</div>
			<p id="install-ios-help" hidden class="mt-4 rounded-2xl bg-white p-4 text-sm text-slate-700">
				On iPhone or iPad: tap
				<Share className="mx-0.5 inline size-4 align-text-bottom text-indigo-600" aria-label="Share" />
				<strong>Share</strong> in the browser bar, then choose <strong>Add to Home Screen</strong>.
			</p>
		</section>

		{
			topics.length === 0 ? (
				<p class="py-16 text-center text-slate-500">No topics available.</p>
			) : (
				<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
					{topics.map((topic) => (
						<li>
							<a
								href={`/topics/${topic.id}`}
								class="group flex h-full flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-500"
							>
								<h2 class="text-xl font-bold text-slate-800 group-hover:text-indigo-600">
									{topic.title}
								</h2>
								<p class="mt-1 text-sm text-slate-500">
									{topic.goals.length} goals · {exerciseCount(topic)} exercises
								</p>
								<ul class="mt-4 flex flex-wrap gap-2">
									{topic.goals.map((goal) => (
										<li class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-700">
											{goal.title}
										</li>
									))}
								</ul>
								<span class="mt-auto pt-5 text-sm font-semibold text-indigo-600">
									Start practicing <span aria-hidden="true">→</span>
								</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</main>

	<a
		href="/test"
		class="fixed right-6 bottom-[calc(1.5rem+env(safe-area-inset-bottom))] z-20 flex items-center gap-2 rounded-full bg-indigo-600 px-6 py-4 text-lg font-bold text-white shadow-lg shadow-indigo-300 transition hover:-translate-y-0.5 hover:bg-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-300"
	>
		<BookCheck />
		<span
			id="test-score"
			hidden
			class="rounded-full bg-white/20 px-2.5 py-0.5 text-sm font-semibold"
			title="Tests passed"></span>
	</a>
</BaseLayout>

<script>
	import { loadTestStats } from "../lib/test";
	import { setupInstallCard } from "../lib/install";

	setupInstallCard();

	// The score lives in this browser's storage, so it's filled in on the client.
	const badge = document.getElementById("test-score");
	const { passed } = loadTestStats();
	if (badge && passed > 0) {
		badge.textContent = `★ ${passed}`;
		badge.setAttribute("aria-label", `${passed} tests passed`);
		badge.hidden = false;
	}
</script>
